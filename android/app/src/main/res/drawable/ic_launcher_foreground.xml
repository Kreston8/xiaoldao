<?xml version="1.0" encoding="utf-8"?>
<!-- 岛仔: one white capsule, two round eyes, one smile. The glyph is drawn from scratch so the
     launcher icon belongs to this app and to nobody else: no borrowed shape, no borrowed palette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The capsule body, 48 x 42 with fully round ends. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51,33 L57,33 A21,21 0 0 1 78,54 A21,21 0 0 1 57,75 L51,75 A21,21 0 0 1 30,54 A21,21 0 0 1 51,33 Z" />

    <!-- Eyes, spaced far enough apart that they never merge at 48 dp. -->
    <path
        android:fillColor="#FF17171E"
        android:pathData="M46.4,49.6 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0" />
    <path
        android:fillColor="#FF17171E"
        android:pathData="M61.6,49.6 m-4.2,0 a4.2,4.2 0 1,0 8.4,0 a4.2,4.2 0 1,0 -8.4,0" />

    <!-- Mouth: a short relaxed smile, stroked so it stays light at small sizes. -->
    <path
        android:strokeColor="#FF17171E"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M48,59.5 Q54,64.5 60,59.5" />
</vector>
