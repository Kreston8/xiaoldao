<?xml version="1.0" encoding="utf-8"?>
<!-- 小灵岛 xiaoldao: a neon capsule with two glowing eyes on a black tile.
     Every shape here was drawn for this app: no borrowed glyph, no borrowed palette.
     Adaptive icons are masked to 108 x 108 with a 72 dp safe zone, so all artwork stays inside
     x/y 22..86 and survives every launcher mask (circle, squircle, teardrop).

     2.17: the capsule is flatter (28 dp tall instead of 36), the two HUD ticks on the sides are
     gone, and the eyes are no longer circles. They are the same vertical pills the island itself
     draws (XiaoldaoView): pale, taller than wide, spaced a little under half the capsule height
     apart, so the icon and the on-screen island read as the same face. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Emissive halo: makes the capsule look lit instead of painted. Squashed to the new height. -->
    <path
        android:pathData="M54,54 m-30,0 a30,24 0 1,0 60,0 a30,24 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:startColor="#5E22D3EE"
                android:centerColor="#2219B8FF"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- The capsule: a 46 x 28 pill, stroked only, so the black tile shows through the middle. -->
    <path
        android:pathData="M45,40 L63,40 A14,14 0 0 1 77,54 A14,14 0 0 1 63,68 L45,68 A14,14 0 0 1 31,54 A14,14 0 0 1 45,40 Z"
        android:fillColor="#00000000"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="40"
                android:endX="77"
                android:endY="68"
                android:startColor="#FF22D3EE"
                android:endColor="#FFA855F7" />
        </aapt:attr>
    </path>

    <!-- Bloom behind the eyes only, so the pale pixels get a rim of light without washing out. -->
    <path android:pathData="M54,54 m-16,0 a16,11 0 1,0 32,0 a16,11 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="16"
                android:startColor="#4DB9EEFF"
                android:centerColor="#1AB9EEFF"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- Left eye: 6.6 x 9.6 vertical pill, the shape the island draws, not a circle. -->
    <path android:pathData="M44.2,52.6 A3.3,3.3 0 0 1 50.8,52.6 L50.8,55.4 A3.3,3.3 0 0 1 44.2,55.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="47.5"
                android:centerY="54"
                android:gradientRadius="7.4"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFF0F1F6"
                android:endColor="#FFD7DFEC" />
        </aapt:attr>
    </path>
    <!-- Right eye: same pill 13 dp to the right, which keeps the two apart at 48 dp. -->
    <path android:pathData="M57.2,52.6 A3.3,3.3 0 0 1 63.8,52.6 L63.8,55.4 A3.3,3.3 0 0 1 57.2,55.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="60.5"
                android:centerY="54"
                android:gradientRadius="7.4"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFF0F1F6"
                android:endColor="#FFD7DFEC" />
        </aapt:attr>
    </path>

</vector>
